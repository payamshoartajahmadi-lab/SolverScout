{
  "$defs": {
    "DerivationRecord": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "count",
            "sum",
            "median",
            "iqr_linear",
            "negate",
            "subtract",
            "relative_decrease_percent",
            "bounds_membership",
            "format_group",
            "common_value"
          ],
          "type": "string"
        },
        "input_fact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "definition_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        }
      },
      "required": [
        "operation",
        "input_fact_refs",
        "definition_version"
      ],
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "run_record",
            "source_passage",
            "derived_calculation"
          ],
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "original_content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "run_specific",
            "family_level",
            "implementation_level"
          ],
          "type": "string"
        },
        "stale": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "locator",
        "text",
        "content_sha256",
        "original_content_sha256",
        "excerpt_start",
        "excerpt_end",
        "source_url",
        "source_title",
        "scope",
        "stale"
      ],
      "type": "object"
    },
    "FactRecord": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "type": "string"
        },
        "value_type": {
          "enum": [
            "number",
            "integer",
            "text",
            "boolean",
            "number_vector"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "available",
            "missing"
          ],
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_text": {
          "type": "string"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origin": {
          "enum": [
            "recorded",
            "derived",
            "mathematical_constant"
          ],
          "type": "string"
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fact_id",
        "value_type",
        "value",
        "availability",
        "unit",
        "display_text",
        "source_paths",
        "evidence_refs",
        "origin",
        "derivation"
      ],
      "type": "object"
    },
    "MethodIdentity": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "implementation_id": {
          "type": "string"
        },
        "display_name_fa": {
          "type": "string"
        }
      },
      "required": [
        "alias",
        "implementation_id",
        "display_name_fa"
      ],
      "type": "object"
    },
    "NarrativeParagraphV3": {
      "additionalProperties": false,
      "properties": {
        "paragraph_id": {
          "type": "string"
        },
        "claim_kind": {
          "enum": [
            "recorded",
            "derived",
            "interpretation"
          ],
          "type": "string"
        },
        "text_fa": {
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paragraph_id",
        "claim_kind",
        "text_fa",
        "fact_refs",
        "evidence_refs"
      ],
      "type": "object"
    },
    "NarrativeSectionV3": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "enum": [
            "problem",
            "candidate_rationale",
            "selection",
            "solution",
            "verification_and_limits",
            "mathematical_analysis"
          ],
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/NarrativeParagraphV3"
          },
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "paragraphs"
      ],
      "type": "object"
    },
    "OmissionRecord": {
      "additionalProperties": false,
      "properties": {
        "item_ref": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "size_limit",
            "missing",
            "not_relevant"
          ],
          "type": "string"
        }
      },
      "required": [
        "item_ref",
        "reason"
      ],
      "type": "object"
    },
    "RenderedParagraphV1": {
      "additionalProperties": false,
      "properties": {
        "paragraph_id": {
          "type": "string"
        },
        "text_fa": {
          "type": "string"
        }
      },
      "required": [
        "paragraph_id",
        "text_fa"
      ],
      "type": "object"
    },
    "RenderedSectionV1": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "enum": [
            "problem",
            "candidate_rationale",
            "selection",
            "solution",
            "verification_and_limits",
            "mathematical_analysis"
          ],
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/RenderedParagraphV1"
          },
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "paragraphs"
      ],
      "type": "object"
    },
    "ReportEvidenceV3": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "3.0"
          ]
        },
        "job_id": {
          "type": "string"
        },
        "source_report_schema_version": {
          "type": "string"
        },
        "source_core_sha256": {
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/FactRecord"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionRequirement"
          },
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/MethodIdentity"
          },
          "type": "array"
        },
        "omissions": {
          "items": {
            "$ref": "#/$defs/OmissionRecord"
          },
          "type": "array"
        },
        "evidence_policy_version": {
          "enum": [
            "1.0",
            "1.1"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "source_report_schema_version",
        "source_core_sha256",
        "facts",
        "sources",
        "sections",
        "methods",
        "omissions",
        "evidence_policy_version"
      ],
      "type": "object"
    },
    "ReviewRepairFeedbackV1": {
      "additionalProperties": false,
      "properties": {
        "previous_invocation_id": {
          "type": "string"
        },
        "previous_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_response_text": {
          "type": "string"
        },
        "previous_response_truncated": {
          "type": "boolean"
        },
        "validation_diagnostics": {
          "items": {
            "$ref": "#/$defs/ReviewValidationDiagnosticV1"
          },
          "type": "array"
        }
      },
      "required": [
        "previous_invocation_id",
        "previous_call_id",
        "previous_response_text",
        "previous_response_truncated",
        "validation_diagnostics"
      ],
      "type": "object"
    },
    "ReviewValidationDiagnosticV1": {
      "additionalProperties": false,
      "description": "Safe server-owned response diagnostics; never exception input or ctx.",
      "properties": {
        "field_path": {
          "type": "string"
        },
        "error_type": {
          "type": "string"
        },
        "expected_rule": {
          "type": "string"
        },
        "repair_instruction_fa": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "parsing",
            "structural_validation",
            "relational_validation",
            "context_validation"
          ],
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_representation": {
          "enum": [
            "canonical_json",
            "utf8",
            "unavailable"
          ],
          "type": "string"
        },
        "review_contract_version": {
          "type": "string",
          "enum": [
            "narrative_review/1.0"
          ]
        }
      },
      "required": [
        "field_path",
        "error_type",
        "expected_rule",
        "repair_instruction_fa",
        "stage",
        "response_sha256",
        "response_representation",
        "review_contract_version"
      ],
      "type": "object"
    },
    "SectionHashV1": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "enum": [
            "problem",
            "candidate_rationale",
            "selection",
            "solution",
            "verification_and_limits",
            "mathematical_analysis"
          ],
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "sha256"
      ],
      "type": "object"
    },
    "SectionRequirement": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "enum": [
            "problem",
            "candidate_rationale",
            "selection",
            "solution",
            "verification_and_limits",
            "mathematical_analysis"
          ],
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "required_fact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requirement_text_fa": {
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "required",
        "required_fact_refs",
        "allowed_evidence_refs",
        "requirement_text_fa"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned response-repair input; legacy frozen 1.0 stays closed.",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "prompt_bundle_sha256": {
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/ReportEvidenceV3"
    },
    "context_hash": {
      "type": "string"
    },
    "request_hash": {
      "type": "string"
    },
    "draft_hash": {
      "type": "string"
    },
    "draft_sections": {
      "items": {
        "$ref": "#/$defs/NarrativeSectionV3"
      },
      "type": "array"
    },
    "rendered_sections": {
      "items": {
        "$ref": "#/$defs/RenderedSectionV1"
      },
      "type": "array"
    },
    "section_scope": {
      "items": {
        "enum": [
          "problem",
          "candidate_rationale",
          "selection",
          "solution",
          "verification_and_limits",
          "mathematical_analysis"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "accepted_section_hashes": {
      "items": {
        "$ref": "#/$defs/SectionHashV1"
      },
      "type": "array"
    },
    "review_repair": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewRepairFeedbackV1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "prompt_bundle_sha256",
    "evidence",
    "context_hash",
    "request_hash",
    "draft_hash",
    "draft_sections",
    "rendered_sections",
    "section_scope",
    "accepted_section_hashes",
    "review_repair"
  ],
  "type": "object"
}
