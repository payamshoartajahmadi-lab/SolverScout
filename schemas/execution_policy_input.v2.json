{
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "const": "2.0",
      "title": "Policy Version",
      "type": "string"
    },
    "portfolio_id": {
      "const": "continuous_catalog_v2",
      "title": "Portfolio Id",
      "type": "string"
    },
    "selection_policy": {
      "enum": [
        "web_research_then_pilot",
        "catalog_llm_then_pilot",
        "catalog_fixed"
      ],
      "title": "Selection Policy",
      "type": "string"
    },
    "max_objective_evaluations": {
      "maximum": 1000000,
      "minimum": 1002,
      "title": "Max Objective Evaluations",
      "type": "integer"
    },
    "max_compute_seconds": {
      "maximum": 3600,
      "minimum": 11,
      "title": "Max Compute Seconds",
      "type": "integer"
    },
    "master_seed": {
      "exclusiveMaximum": 4294967296,
      "minimum": 0,
      "title": "Master Seed",
      "type": "integer"
    },
    "explain_via_llm": {
      "title": "Explain Via Llm",
      "type": "boolean"
    },
    "fixed_implementation_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9_.]+:[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixed Implementation Id"
    },
    "fixed_config_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixed Config Id"
    },
    "research_mode": {
      "default": "live",
      "enum": [
        "live",
        "cache_only"
      ],
      "title": "Research Mode",
      "type": "string"
    },
    "on_research_failure": {
      "default": "stop",
      "enum": [
        "stop",
        "continue_with_catalog"
      ],
      "title": "On Research Failure",
      "type": "string"
    },
    "max_cache_age_hours": {
      "default": 24,
      "maximum": 720,
      "minimum": 1,
      "title": "Max Cache Age Hours",
      "type": "integer"
    }
  },
  "required": [
    "policy_version",
    "portfolio_id",
    "selection_policy",
    "max_objective_evaluations",
    "max_compute_seconds",
    "master_seed",
    "explain_via_llm"
  ],
  "title": "ExecutionPolicyInputV2",
  "type": "object"
}
