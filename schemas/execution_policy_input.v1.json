{
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "const": "1.0",
      "title": "Policy Version",
      "type": "string"
    },
    "portfolio_id": {
      "const": "continuous_v1",
      "title": "Portfolio Id",
      "type": "string"
    },
    "selection_policy": {
      "enum": [
        "fixed_solver",
        "random_solver",
        "rule_based",
        "llm_only",
        "pilot_only",
        "llm_shortlist_then_pilot"
      ],
      "title": "Selection Policy",
      "type": "string"
    },
    "fixed_algorithm_id": {
      "anyOf": [
        {
          "enum": [
            "abc.original",
            "cma_es.mealpy",
            "de.original",
            "pso.original"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fixed Algorithm Id"
    },
    "max_objective_evaluations": {
      "maximum": 1000000,
      "minimum": 1002,
      "title": "Max Objective Evaluations",
      "type": "integer"
    },
    "max_compute_seconds": {
      "maximum": 3600,
      "minimum": 11,
      "title": "Max Compute Seconds",
      "type": "integer"
    },
    "master_seed": {
      "exclusiveMaximum": 4294967296,
      "minimum": 0,
      "title": "Master Seed",
      "type": "integer"
    },
    "explain_via_llm": {
      "title": "Explain Via Llm",
      "type": "boolean"
    }
  },
  "required": [
    "policy_version",
    "portfolio_id",
    "selection_policy",
    "fixed_algorithm_id",
    "max_objective_evaluations",
    "max_compute_seconds",
    "master_seed",
    "explain_via_llm"
  ],
  "title": "ExecutionPolicyInput",
  "type": "object"
}
