{
  "$defs": {
    "ResearchLimits": {
      "additionalProperties": false,
      "properties": {
        "max_search_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Search Attempts",
          "type": "integer"
        },
        "max_queries": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Queries",
          "type": "integer"
        },
        "max_results_per_query": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Results Per Query",
          "type": "integer"
        },
        "max_documents": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Documents",
          "type": "integer"
        },
        "max_redirects": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Redirects",
          "type": "integer"
        },
        "max_http_requests": {
          "default": 27,
          "maximum": 27,
          "minimum": 1,
          "title": "Max Http Requests",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "default": 20.0,
          "gt": 0,
          "le": 30,
          "title": "Request Timeout Seconds",
          "type": "number"
        },
        "active_timeout_seconds": {
          "default": 120.0,
          "gt": 0,
          "le": 180,
          "title": "Active Timeout Seconds",
          "type": "number"
        },
        "max_document_bytes": {
          "default": 5242880,
          "maximum": 10485760,
          "minimum": 1,
          "title": "Max Document Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 20971520,
          "maximum": 31457280,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "max_text_chars": {
          "default": 60000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Text Chars",
          "type": "integer"
        },
        "max_passage_chars": {
          "default": 18000,
          "maximum": 24000,
          "minimum": 1,
          "title": "Max Passage Chars",
          "type": "integer"
        },
        "max_solver_cards": {
          "default": 20,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Solver Cards",
          "type": "integer"
        }
      },
      "title": "ResearchLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "provider_id": {
      "const": "tavily",
      "default": "tavily",
      "title": "Provider Id",
      "type": "string"
    },
    "endpoint": {
      "const": "https://api.tavily.com/search",
      "default": "https://api.tavily.com/search",
      "title": "Endpoint",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/ResearchLimits",
      "default": {
        "max_search_attempts": 3,
        "max_queries": 3,
        "max_results_per_query": 5,
        "max_documents": 6,
        "max_redirects": 3,
        "max_http_requests": 27,
        "request_timeout_seconds": 20.0,
        "active_timeout_seconds": 120.0,
        "max_document_bytes": 5242880,
        "max_total_bytes": 20971520,
        "max_text_chars": 60000,
        "max_passage_chars": 18000,
        "max_solver_cards": 20
      }
    },
    "credential_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Ref"
    }
  },
  "required": [
    "profile_id",
    "revision"
  ],
  "title": "SearchProfile",
  "type": "object"
}
