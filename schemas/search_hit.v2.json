{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "query_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Query Id",
      "type": "string"
    },
    "url": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "title": {
      "default": "",
      "maxLength": 500,
      "title": "Title",
      "type": "string"
    },
    "snippet": {
      "default": "",
      "maxLength": 4000,
      "title": "Snippet",
      "type": "string"
    },
    "provider_rank": {
      "minimum": 1,
      "title": "Provider Rank",
      "type": "integer"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "source_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "canonical_url": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Url"
    },
    "rejection_code": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Code"
    }
  },
  "required": [
    "query_id",
    "url",
    "provider_rank"
  ],
  "title": "SearchHit",
  "type": "object"
}
